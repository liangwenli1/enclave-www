# TLS 在 Cloudflare 那一层终止，cloudflared 用明文 HTTP 连过来，并带上 X-Forwarded-Proto: https。
# Caddy 默认不信上游的转发头、会把它改写成 http —— 那样 API 就判断不出用户其实走的是
# HTTPS，会话 cookie 永远不带 Secure。这里只信内网地址来的转发头（cloudflared 在本机 / 容器网段）。
{
	servers {
		trusted_proxies static private_ranges
		# X-Forwarded-For 的第一跳是客户端自己能填的（Cloudflare 只在后面追加），拿它限流等于没限。
		# Cf-Connecting-Ip 由 Cloudflare 写入、客户端改不了。
		client_ip_headers Cf-Connecting-Ip
	}
}

# 官网。前面挂 Cloudflare Tunnel，指到这台机的 127.0.0.1:3011。
# 页面由 Next.js 渲染（web），/api/* 交给账号服务（api），两者同源，浏览器侧没有跨域、cookie 直接可用。
# 内容安全策略由 Next.js 按请求生成（带 nonce，见 web/proxy.ts），这里不重复设——两份 CSP 会同时生效、互相打架。
:3011 {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		-Server
	}

	handle /api/* {
		reverse_proxy api:3012 {
			# 只把 Caddy 认定的那个客户端 IP 传给账号服务，丢掉客户端自带的那串。
			header_up X-Forwarded-For {client_ip}
		}
	}

	handle {
		reverse_proxy web:3000
	}
}
